# Copy to .env and adjust the values for your machine:
#
#   cp .env.example .env
#
# Every variable below has a safe default, so the service also runs with an
# empty environment. Values shown here are the defaults.

# Deployment environment: development | production
APP_ENV=development

# Address the HTTP server listens on, in host:port form.
HTTP_ADDR=:8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Maximum time allowed to read request headers.
READ_HEADER_TIMEOUT=5s

# Time budget for in-flight requests when the server shuts down.
SHUTDOWN_TIMEOUT=10s
