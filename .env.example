# Copy to .env and adjust the values for your machine:
#
#   cp .env.example .env
#
# DATABASE_URL is required; every other variable has a default.

# Deployment environment: development | production
APP_ENV=development

# Address the HTTP server listens on, in host:port form.
HTTP_ADDR=:8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection string (required).
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks?sslmode=disable

# Maximum time allowed to read request headers.
READ_HEADER_TIMEOUT=5s

# Maximum time allowed to read a full request.
READ_TIMEOUT=10s

# Maximum time allowed to write a response.
WRITE_TIMEOUT=15s

# How long an idle keep-alive connection is kept open.
IDLE_TIMEOUT=60s

# Time budget for in-flight requests when the server shuts down.
SHUTDOWN_TIMEOUT=10s

# Go module proxy used when building the container image. Override this when
# proxy.golang.org is unreachable from your network, for example with a local
# mirror. docker compose reads this file for build arguments.
# GOPROXY=https://package-mirror.liara.ir/repository/go/
